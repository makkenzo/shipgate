{
  "name": "shipgate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.14.0 <12"
  },
  "scripts": {
    "start:api": "pnpm --filter @shipgate/server start:api",
    "start:worker": "pnpm --filter @shipgate/server start:worker",
    "dev": "pnpm dev:infra && pnpm db:migrate && pnpm dev:apps",
    "dev:infra": "docker compose up -d --wait postgres",
    "dev:apps": "concurrently --kill-others --names packages,api,worker,web \"pnpm --filter './packages/**' --parallel dev\" \"pnpm --filter @shipgate/server dev:api\" \"pnpm --filter @shipgate/server dev:worker\" \"pnpm --filter @shipgate/web dev\"",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v",
    "build": "pnpm --recursive --if-present run build",
    "lint": "pnpm check:boundaries && biome lint . --error-on-warnings",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:cycles": "node scripts/check-boundaries.mjs && biome lint . --error-on-warnings",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "clean": "pnpm --recursive --if-present run clean",
    "db:migrate": "pnpm --filter @shipgate/server build && node --env-file-if-exists=.env --enable-source-maps apps/server/dist/migrate.js",
    "db:rollback": "pnpm --filter @shipgate/server build && node --env-file-if-exists=.env --enable-source-maps apps/server/dist/database-cli.js down",
    "db:status": "pnpm --filter @shipgate/server build && node --env-file-if-exists=.env --enable-source-maps apps/server/dist/database-cli.js status",
    "db:migrate:prod": "node --enable-source-maps apps/server/dist/migrate.js",
    "jobs:diagnostic": "pnpm --filter @shipgate/server build && node --env-file-if-exists=.env --enable-source-maps apps/server/dist/diagnostic-cli.js",
    "github:doctor": "pnpm --filter @shipgate/server build && node --env-file-if-exists=.env --enable-source-maps apps/server/dist/github-doctor.js",
    "github:manifest": "pnpm --filter @shipgate/server build && node --env-file-if-exists=.env --enable-source-maps apps/server/dist/github-manifest.js",
    "api:generate": "pnpm --filter @shipgate/server openapi:generate && pnpm --filter @shipgate/web api:generate && biome format --write apps/web/openapi apps/web/src/api/generated",
    "api:generate:check": "pnpm api:generate && git diff --exit-code -- apps/web/openapi apps/web/src/api/generated",
    "api:generate:compiled": "pnpm --filter @shipgate/server openapi:generate:compiled && pnpm --filter @shipgate/web api:generate && biome format --write apps/web/openapi apps/web/src/api/generated",
    "api:generate:compiled:check": "pnpm api:generate:compiled && git diff --exit-code -- apps/web/openapi apps/web/src/api/generated",
    "routes:generate:check": "pnpm --filter @shipgate/web routes:generate && git diff --exit-code -- apps/web/src/routeTree.gen.ts",
    "docker:build": "docker build --target runtime --tag shipgate:local .",
    "compose:up": "docker compose up -d --wait",
    "compose:down": "docker compose down",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm build && pnpm api:generate:compiled:check && pnpm routes:generate:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.13.3",
    "concurrently": "10.0.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.14.0+sha512.66c1ac4c7d4762d6d7dde44c7f3e5a73591ed0a0806e751d4ed32d4f004f25b2285a906b1fd8a9e3e621df3b4e2858bf88e50e0cf626bedbe977fe434a5caf85"
}
