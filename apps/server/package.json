{
  "name": "@shipgate/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "tsc --build tsconfig.build.json --clean",
    "test:e2e": "vitest run test/e2e --passWithNoTests"
  },
  "dependencies": {
    "@shipgate/config": "workspace:*",
    "@shipgate/database": "workspace:*",
    "@shipgate/domain": "workspace:*",
    "@shipgate/github": "workspace:*"
  },
  "devDependencies": {
    "@shipgate/testing": "workspace:*",
    "vitest": "4.1.10"
  }
}
