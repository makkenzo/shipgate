{
  "name": "@shipgate/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "routes:generate": "tsr generate",
    "typecheck": "pnpm routes:generate && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "api:generate": "openapi-ts",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => { rmSync('dist', { recursive: true, force: true }) })\""
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hey-api/client-fetch": "0.13.1",
    "@shipgate/config": "workspace:*",
    "@shipgate/domain": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@shipgate/testing": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.21",
    "@tanstack/router-plugin": "1.168.23",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "tailwindcss": "4.3.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
