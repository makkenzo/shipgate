{
  "name": "@shipgate/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm --filter @shipgate/testing build && pnpm build && vitest run",
    "clean": "tsc --build tsconfig.build.json --clean"
  },
  "dependencies": {
    "@shipgate/config": "workspace:*",
    "@shipgate/database": "workspace:*",
    "graphile-worker": "0.17.3",
    "kysely": "0.29.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@shipgate/testing": "workspace:*",
    "vitest": "4.1.10"
  }
}
