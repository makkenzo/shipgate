{
  "name": "@shipgate/github",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "tsc --build tsconfig.build.json --clean"
  },
  "dependencies": {
    "@shipgate/config": "workspace:*",
    "@shipgate/domain": "workspace:*"
  },
  "devDependencies": {
    "@shipgate/testing": "workspace:*",
    "vitest": "4.1.10"
  }
}
