{
  "name": "@shipgate/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm --filter @shipgate/testing build && pnpm build && vitest run",
    "clean": "tsc --build tsconfig.build.json --clean"
  },
  "dependencies": {
    "@shipgate/config": "workspace:*",
    "kysely": "0.29.4",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@shipgate/testing": "workspace:*",
    "@types/pg": "8.20.0"
  }
}
