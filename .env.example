# Application

NODE_ENV=development
APP_VERSION=0.0.0
LOG_LEVEL=debug

# Lifecycle

SHUTDOWN_TIMEOUT_MS=10000

# HTTP API

HOST=127.0.0.1
PORT=3000

API_BODY_LIMIT_BYTES=65536

# Empty means enabled automatically in development.
API_DOCS_ENABLED=

# Empty means enabled outside production.
API_DIAGNOSTICS_ENABLED=
API_METRICS_ENABLED=

# Exact browser origins allowed to make cross-origin requests.
# Empty uses localhost defaults in development and disables CORS in production.
API_CORS_ORIGINS=

# PostgreSQL
#
# Host-side connection used by pnpm dev, migration commands and tests.
# Docker publishes PostgreSQL as 127.0.0.1:5433 -> postgres:5432.

DATABASE_URL=postgresql://shipgate:shipgate@127.0.0.1:5433/shipgate

DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_MAX_LIFETIME_SECONDS=300
DATABASE_READINESS_TIMEOUT_MS=2000

# disable | require | verify-full
DATABASE_SSL_MODE=disable

# Optional PEM certificate authority for verify-full.
DATABASE_SSL_CA=

# Background jobs

JOB_WORKER_CONCURRENCY=4
JOB_WORKER_POLL_INTERVAL_MS=2000

JOB_WORKER_HEARTBEAT_INTERVAL_MS=10000
JOB_WORKER_HEARTBEAT_STALE_AFTER_MS=60000

# Frontend development
#
# Vite proxies backend requests to this address.

VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# GitHub App
#
# Runtime startup validation is enabled automatically in production. Development
# can start without these values, but GitHub authentication and webhooks require
# a registered app. Keep secrets only in the untracked .env file.

APP_ORIGIN=
GITHUB_APP_STARTUP_VALIDATION_ENABLED=

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_USER_TOKENS_EXPIRE=true

GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

GITHUB_API_URL=https://api.github.com
GITHUB_OAUTH_URL=https://github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_API_REQUEST_TIMEOUT_MS=10000

GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_TOKEN_ENCRYPTION_KEY_ID=primary
GITHUB_TOKEN_EARLY_REFRESH_MS=300000
GITHUB_REFRESH_LEASE_MS=60000
GITHUB_REFRESH_LEASE_POLL_MS=100
GITHUB_WEBHOOK_BODY_LIMIT_BYTES=10485760
