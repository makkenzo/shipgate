# Application

NODE_ENV=development
APP_VERSION=0.0.0
LOG_LEVEL=debug

# HTTP API

HOST=127.0.0.1
PORT=3000

# Lifecycle

SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL

DATABASE_URL=postgresql://shipgate:shipgate@127.0.0.1:5432/shipgate

DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_MAX_LIFETIME_SECONDS=300
DATABASE_READINESS_TIMEOUT_MS=2000

# disable | require | verify-full
DATABASE_SSL_MODE=disable

# Optional PEM certificate authority for verify-full
DATABASE_SSL_CA=

# GitHub App runtime configuration

GITHUB_APP_ID=

# GitHub App secrets

GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Background jobs

JOB_WORKER_CONCURRENCY=4
JOB_WORKER_POLL_INTERVAL_MS=2000

JOB_WORKER_HEARTBEAT_INTERVAL_MS=10000
JOB_WORKER_HEARTBEAT_STALE_AFTER_MS=60000

# HTTP API

HOST=127.0.0.1
PORT=3000

# Maximum JSON request body: 64 KiB
API_BODY_LIMIT_BYTES=65536

# Empty means: enabled only in development
API_DOCS_ENABLED=

# Used only when NODE_ENV=development
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend development proxy

VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Empty means same-origin:
# - Vite proxy in development
# - Fastify origin in production

VITE_API_BASE_URL=